# Alternate RunPod build definition.
# Select this file as the Dockerfile path when creating the endpoint.

FROM nvidia/cuda:12.8.0-runtime-ubuntu22.04

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    libcurl4 \
    libgomp1 \
    pciutils \
    procps \
    python3 \
    python3-pip \
    tar \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ARG BUILD_CACHE_BUSTER="v1.0.5"
ARG LLAMA_PRISM_RELEASE="https://github.com/PrismML-Eng/llama.cpp/releases/download/prism-b10787-73bfe6c/llama-prism-b10787-73bfe6c-bin-linux-cuda-12.8-x64.tar.gz"

# Download to a file first so HTTP, archive, and binary failures are distinct.
RUN mkdir -p /opt/llama.cpp && \
    echo "[Build] Cache buster: ${BUILD_CACHE_BUSTER}" && \
    echo "[Build] Downloading ${LLAMA_PRISM_RELEASE}" && \
    curl --fail --show-error --location --retry 3 --retry-all-errors \
        --connect-timeout 20 --output /tmp/llama-prism.tar.gz "$LLAMA_PRISM_RELEASE" && \
    tar -xzf /tmp/llama-prism.tar.gz -C /opt/llama.cpp && \
    server_path=$(find /opt/llama.cpp -type f -name llama-server -print -quit) && \
    cli_path=$(find /opt/llama.cpp -type f -name llama-cli -print -quit) && \
    test -n "$server_path" && test -n "$cli_path" && \
    install -m 0755 "$server_path" /usr/local/bin/llama-server && \
    install -m 0755 "$cli_path" /usr/local/bin/llama-cli && \
    echo "/opt/llama.cpp" > /etc/ld.so.conf.d/llama.conf && \
    find /opt/llama.cpp -type d \( -name 'lib*' -o -name 'bin*' \) >> /etc/ld.so.conf.d/llama.conf && \
    ldconfig && \
    rm -f /tmp/llama-prism.tar.gz

ENV LD_LIBRARY_PATH="/opt/llama.cpp:/opt/llama.cpp/bin:/opt/llama.cpp/lib:${LD_LIBRARY_PATH}"

COPY requirements.txt /app/requirements.txt
RUN python3 -m pip install --no-cache-dir -r /app/requirements.txt

COPY entrypoint.sh /app/entrypoint.sh
COPY handler.py /app/handler.py
COPY handler.py /handler.py
COPY rp_handler.py /app/rp_handler.py
COPY rp_handler.py /rp_handler.py
COPY test_input.json /app/test_input.json
COPY test_input.json /test_input.json
COPY src /app/src
COPY .runpod /app/.runpod

RUN chmod +x /app/entrypoint.sh /app/handler.py /handler.py \
    /app/rp_handler.py /rp_handler.py /app/src/handler.py /app/src/rp_handler.py && \
    mkdir -p /workspace/models

ENV MODEL_PATH="/workspace/models/Ternary-Bonsai-2-27B-PQ2_0.gguf" \
    MMPROJ_PATH="/workspace/models/Ternary-Bonsai-2-27B-mmproj-BF16.gguf" \
    HF_REPO_ID="prism-ml/Ternary-Bonsai-2-27B-gguf" \
    HF_MODEL_FILE="Ternary-Bonsai-2-27B-PQ2_0.gguf" \
    HF_MMPROJ_FILE="Ternary-Bonsai-2-27B-mmproj-BF16.gguf" \
    HOST="0.0.0.0" \
    PORT=8000 \
    CTX_SIZE="261120" \
    PARALLEL_SLOTS="6" \
    KV_CACHE_TYPE_K="q8_0" \
    KV_CACHE_TYPE_V="q8_0" \
    BATCH_SIZE=4096 \
    UBATCH_SIZE=1024 \
    FLASH_ATTENTION=true \
    MAX_TOKENS=8192 \
    N_GPU_LAYERS=99 \
    RUNPOD_MODE="auto"

EXPOSE 8000

CMD ["python3", "-u", "/handler.py"]
